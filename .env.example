# Local-only demo; never use real customer data.
HOST=127.0.0.1
PORT=8787
# Local synthetic intent/payment records; preserve this directory across restarts.
VOWRAIL_STATE_DIR=.vowrail/journal

# PayPal Sandbox credentials from https://developer.paypal.com/
# Only the Sandbox API host is supported; NEVER production payments.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# An approved externally reachable origin can be needed for return redirects.
PUBLIC_BASE_URL=http://127.0.0.1:8787

# Optional compatible chat-completions provider for buyer recommendations.
# Optional synthetic LLM seller replaces ONE of the scripted sellers when AI_MERCHANTS=1.
# The model gets public requirements / eligible offers, never the private max-budget.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
AI_MERCHANTS=0

# Existing OpenRouter key selects free-only routing ahead of legacy AI_* settings.
# No model/provider fallback; prompt/completion/request price caps are zero.
# Only explicit :free variants accepted. Default is the model below.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
