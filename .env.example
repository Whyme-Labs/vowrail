# This application runs in demo-only mode without credentials.
HOST=127.0.0.1
PORT=8787

# PayPal Sandbox credentials from https://developer.paypal.com/
# Only the Sandbox API host is supported; NEVER production payments.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Set to the externally reachable origin if testing PayPal return redirects.
# A localhost return URL may not be usable in every PayPal configuration.
PUBLIC_BASE_URL=http://127.0.0.1:8787

# Optional compatible chat-completions provider for buyer recommendations.
# The configured provider receives eligible offers and public requirements,
# not the private max-budget field. Review provider data handling before use.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
