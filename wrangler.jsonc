{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vowrail-judges",
  "account_id": "1e0170aaabc90ecf5f466128d1f0466a",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "secrets": { "required": ["SESSION_SECRET", "PAYPAL_CLIENT_ID", "PAYPAL_CLIENT_SECRET", "OPENROUTER_API_KEY"] },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "vars": {
    "PUBLIC_ORIGIN": "https://vowrail-judges.swmengappdev.workers.dev",
    "OPENROUTER_MODEL": "nvidia/nemotron-3.5-lightning:free"
  },
  "durable_objects": {
    "bindings": [
      { "name": "SESSIONS", "class_name": "JudgeSession" },
      { "name": "LIMITS", "class_name": "RequestLimits" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["JudgeSession", "RequestLimits"] }],
  "ratelimits": [{ "name": "API_RATE", "namespace_id": "818271001", "simple": { "limit": 120, "period": 60 } }],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 0.1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
