{
  "name": "vowrail-private-video",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Private problem-led Vowrail film, built with Remotion (https://remotion.pro/license)",
  "scripts": {
    "studio": "node --require ./loopback.cjs node_modules/@remotion/cli/remotion-cli.js studio src/index.jsx --no-open --port=3277",
